<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Needed by the OpenAPI source generator to pick up XML comments, and by IDE0005
         (unused usings), which the compiler only reports when docs are generated. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 would demand an XML comment on every public member, and CS1573 an entry for
         every parameter as soon as one is documented. We document what feeds OpenAPI and what
         carries a trap, such as "OccurredAt is always UTC", not every DTO field. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!-- Every test run leaves a .trx behind. An intermittent failure is worthless if its message
       is gone by the time anyone looks: console output scrolls, the trx keeps the assertion
       text and which test produced it. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <VSTestLogger>trx</VSTestLogger>
    <VSTestResultsDirectory>$(MSBuildThisFileDirectory)TestResults</VSTestResultsDirectory>
  </PropertyGroup>
</Project>
