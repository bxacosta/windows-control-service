{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "FileName": "windows-control-service.db",
    "BusyTimeout": "00:00:05"
  },
  "CodeIntegrity": {
    "OperationTimeout": "00:00:30"
  },
  "Authentication": {
    "SessionTimeout": "00:30:00",
    "MinimumPasswordLength": 10,
    "Pbkdf2Iterations": 210000,
    "LoginAttemptsPerMinute": 5
  },
  "ApplicationBlocking": {
    "ReconciliationInterval": "00:01:00"
  },
  "AccessHistory": {
    "IngestionInterval": "00:01:00",
    "IngestionWindow": "30.00:00:00",
    "MaxPlausibleSessionLength": "7.00:00:00",
    "DefaultPageSize": 10,
    "MaxPageSize": 500
  }
}
