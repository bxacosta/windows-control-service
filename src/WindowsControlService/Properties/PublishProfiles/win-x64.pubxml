<Project>
  <!-- What .\wcs build publishes: dotnet publish -p:PublishProfile=win-x64 -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>

    <!-- Here rather than in the .csproj: a self-contained project cannot be referenced by the
         test projects (NETSDK1150), and a publish profile only applies to the publish. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Off, and measured rather than assumed: publishing trimmed fails with IL2026 on
         ValidateDataAnnotations, MaxLength and MinLength, which DataAnnotations resolves by
         reflection (not Microsoft.Data.Sqlite, the usual suspect). Suppressing it would trade
         options validation that might quietly stop validating for a smaller binary on a service
         installed on one machine. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
