<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>WindowsControlService</RootNamespace>
    <AssemblyName>WindowsControlService</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The publish settings (self-contained, single file, not trimmed) and the reasons for them
         are in Properties\PublishProfiles\win-x64.pubxml. -->

    <!-- The SDK precompresses static web assets into .br and .gz siblings, but UseStaticFiles
         does no content negotiation: it would ship fifteen files that are never served, on a
         loopback interface where compression buys nothing anyway. -->
    <CompressionEnabled>false</CompressionEnabled>

    <!-- web.config only means something to IIS, and this is a Windows service hosting Kestrel
         directly. Publishing one invites the idea that IIS is involved somewhere. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- The process filtering rules are internal so they can be tested against a fixed list
         instead of whatever happens to be running on the machine. -->
    <InternalsVisibleTo Include="WindowsControlService.UnitTests" />
    <InternalsVisibleTo Include="WindowsControlService.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded, not loose on disk, so PublishSingleFile keeps producing a single file.
         DbUp orders scripts by embedded resource name. -->
    <None Remove="Infrastructure\Database\Scripts\*.sql" />
    <EmbeddedResource Include="Infrastructure\Database\Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
