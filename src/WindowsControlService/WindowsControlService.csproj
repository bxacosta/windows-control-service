<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>WindowsControlService</RootNamespace>
    <AssemblyName>WindowsControlService</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SelfContained is passed on the publish command line, not set here: a self-contained
         project cannot be referenced by the test projects (NETSDK1150). See scripts/build.ps1. -->

    <!-- PublishTrimmed stays off, and this was measured rather than assumed. Publishing with
         it on fails outright with IL2026 on ValidateDataAnnotations, MaxLength and MinLength:
         DataAnnotations resolves members by reflection, so the trimmer cannot prove the
         validation still works. Notably this is NOT the Microsoft.Data.Sqlite reflection the
         plan expected to be the blocker.

         Suppressing those warnings would ship a 100 MB binary down to maybe 60 MB in exchange
         for options validation that might quietly stop validating, which is the exact
         failure ValidateOnStart exists to prevent. Not worth it for a service installed on
         one machine. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- The SDK precompresses static web assets into .br and .gz siblings, but UseStaticFiles
         does no content negotiation: it would ship fifteen files that are never served, on a
         loopback interface where compression buys nothing anyway. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- The process filtering rules are internal so they can be tested against a fixed list
         instead of whatever happens to be running on the machine. -->
    <InternalsVisibleTo Include="WindowsControlService.UnitTests" />
    <InternalsVisibleTo Include="WindowsControlService.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded, not loose on disk, so PublishSingleFile keeps producing a single file.
         DbUp orders scripts by embedded resource name. -->
    <None Remove="Infrastructure\Database\Scripts\*.sql" />
    <EmbeddedResource Include="Infrastructure\Database\Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
