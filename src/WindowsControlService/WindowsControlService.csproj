<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>WindowsControlService</RootNamespace>
    <AssemblyName>WindowsControlService</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SelfContained is passed on the publish command line, not set here: a self-contained
         project cannot be referenced by the test projects (NETSDK1150). See scripts/publish.ps1. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded, not loose on disk, so PublishSingleFile keeps producing a single file.
         DbUp orders scripts by embedded resource name. -->
    <None Remove="Infrastructure\Database\Scripts\*.sql" />
    <EmbeddedResource Include="Infrastructure\Database\Scripts\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
